{
    "name": "setmeup",
    "version": "2.0.0",
    "description": "SetMeUp, your single and only settings manager.",
    "keywords": [
        "setmeup",
        "configuration",
        "settings",
        "setup",
        "env"
    ],
    "author": "Igor Ramadas <igor@ramadas.net>",
    "subdomain": "setmeup",
    "license": "MIT",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/esm.d.mts",
                "default": "./lib/esm.mjs"
            },
            "require": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        },
        "./lib/*.js": "./lib/*.js",
        "./lib/*.d.ts": "./lib/*.d.ts",
        "./lib/esm.mjs": "./lib/esm.mjs",
        "./lib/*": "./lib/*.js",
        "./package.json": "./package.json"
    },
    "bin": {
        "setmeup": "./lib/cli.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/igoramadas/setmeup.git"
    },
    "engines": {
        "bun": ">= 1.3",
        "node": ">= 22.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig-build.json",
        "build-test": "tsc -p tsconfig-test.json",
        "clean": "rm -rf ./lib && rm -rf ./lib-test && rm -rf ./coverage",
        "prebuild": "rm -rf ./lib ./lib-test",
        "test": "npm run build && npm run build-test && mocha ./test/*.ts && node ./test/test-esm.mjs",
        "test-bun": "npm run build && npm run build-test && bun --bun run mocha ./test/*.ts && bun ./test/test-esm.mjs",
        "test-coverage": "nyc --reporter=lcov npm test"
    },
    "dependencies": {
        "eventemitter3": "^5.0.4"
    },
    "devDependencies": {
        "@istanbuljs/nyc-config-typescript": "^1.0.2",
        "@types/node": "^26.6.5",
        "anyhow": "^4.0.0",
        "chai": "^4.5.0",
        "coveralls": "^3.1.1",
        "mocha": "^12.0.3",
        "mocha-lcov-reporter": "^1.3.0",
        "nyc": "^18.0.0",
        "source-map-support": "^0.5.21",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "anyhow": "^3.3.0 || ^4.0.0"
    },
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": false,
        "arrowParens": "always",
        "bracketSpacing": false,
        "printWidth": 250
    },
    "mocha": {
        "timeout": 5000,
        "exit": true,
        "recursive": true,
        "require": [
            "test/mocha.env",
            "tsx/cjs",
            "source-map-support/register"
        ]
    },
    "nyc": {
        "extends": "@istanbuljs/nyc-config-typescript",
        "include": [
            "src/**/*"
        ],
        "temp-dir": "./coverage",
        "reporter": [
            "lcov",
            "text"
        ]
    },
    "reviewAgents": {
        "ready": "@coderabbitai"
    }
}
